#!/bin/bash
# GRANULARITY EXPERIMENT — STEP 1: build the three label spaces
#
# Takes the Indian datasets and emits three copies of them that contain the
# SAME images and the SAME boxes, differing only in how those boxes are
# labelled:
#
#   fine      the source dataset's own classes          (control)
#   semantic  grouped by appearance, IDD level-3 style  (second control)
#   decision  the six decision-consequence groups       (ours)
#
# The second control is what makes the experiment mean something. Without it a
# reviewer can only conclude "fewer classes scores higher", which is trivially
# true. With it, the question becomes whether grouping by DECISION CONSEQUENCE
# beats grouping by APPEARANCE at a comparable class count -- and that is the
# claim the paper actually makes.
#
# Images are symlinked, not copied, so three datasets cost one dataset of disk.
#
# Submit:  qsub training/pbs/granularity_step1_prepare.pbs
#PBS -N Gran_Prepare
#PBS -l select=1:ncpus=8:mem=16gb
#PBS -q workq
#PBS -l walltime=04:00:00
#PBS -o logs/gran_step1.log
#PBS -j oe
#
# NOTE: `#PBS -V` is deliberately ABSENT — it exports the submitting shell's
# CONDA_PREFIX/CONDA_SHLVL, after which `conda activate` believes the shell is
# already activated and silently does nothing, leaving /bin/python on PATH.

# NOTE: deliberately NOT using `set -u`. `conda activate` references variables
# (PS1 among others) that are unset in a non-interactive batch shell, and under
# `set -u` the activation aborts silently.
set -o pipefail

cd "$PBS_O_WORKDIR" || exit 1

source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate auto_det

case "$(command -v python)" in
    *auto_det*) ;;
    *)
        ENV_BIN="$(conda info --base 2>/dev/null)/envs/auto_det/bin"
        if [ -x "$ENV_BIN/python" ]; then
            echo "conda activate did not take effect; using $ENV_BIN directly"
            export PATH="$ENV_BIN:$PATH"
        fi
        ;;
esac

export PATH="$HOME/.local/bin:$PATH"
export PYTHONPATH="$HOME/.local/lib/python3.9/site-packages:$PYTHONPATH"

echo "python : $(command -v python)"
case "$(command -v python)" in
    *auto_det*) echo "conda environment: OK" ;;
    *) echo "ERROR: python resolved to $(command -v python), not auto_det"; exit 1 ;;
esac

# Prefer the NATIVE-vocabulary conversions over the merged 15-class set.
#
# The merged taxonomy has already collapsed exactly the distinctions the
# experiment is meant to measure -- Hatchback, Sedan, SUV and MUV are one "car"
# in it -- so a fine arm built from it is not fine-grained, and measuring what
# collapsing costs on already-collapsed labels is circular. Built natively the
# arms span roughly 21 / 10 / 6 classes; from the merged set they would be
# 12 / 11 / 6, and 12 against 11 tests nothing.
#
# UVH-26 alone is vehicles only -- no pedestrians, riders or animals -- so the
# VULNERABLE group would never be exercised and the whole safety argument would
# go untested. IDD supplies those, which is why both are wanted.
#
# Both conversions are cheap and reuse data already on disk, so they are built
# here rather than left as a manual step to forget.
if [ ! -d data/uvh26_native ] && [ -d data/UVH26 ]; then
    echo "Building UVH-26 with its native body-type classes ..."
    python data/prepare_uvh26.py --data_root data/UVH26 \
        --out data/uvh26_native --keep-source-names || exit 1
fi
if [ ! -d data/idd_native ] && [ -d data/IDD_Detection ]; then
    echo "Building IDD with its native label names ..."
    python data/prepare_idd.py --data_root data/IDD_Detection \
        --out data/idd_native --keep-source-names || exit 1
fi

SRCS=""
for candidate in data/idd_native data/uvh26_native; do
    [ -d "$candidate" ] && SRCS="$SRCS $candidate"
done

if [ -z "$SRCS" ]; then
    echo "No native-vocabulary sources found; falling back to the merged set."
    echo "The fine arm will be weaker — see the note above."
    SRCS=data/merged_india_yolo
fi

for s in $SRCS; do
    if [ ! -d "$s" ]; then
        echo "ERROR: $s not found — run training/pbs/india_step1_prepare.pbs first."
        exit 1
    fi
done
echo "sources: $SRCS"

case "$SRCS" in
    *idd_native*) ;;
    *) echo ""
       echo "NOTE: no IDD source. UVH-26 is vehicles only, so VULNERABLE"
       echo "      (pedestrians, riders, animals) will not appear in any arm"
       echo "      and the safety-weighted result will not test the case it"
       echo "      exists for. Add data/idd_native when IDD access comes"
       echo "      through, and re-run." ;;
esac

echo "============================================"
echo "  GRANULARITY EXPERIMENT — DATASET BUILD"
echo "  sources:$SRCS"
echo "  $(date)"
echo "============================================"

# Before writing anything: what does the mapping actually keep?
#
# This takes seconds and answers the question that decides whether the run is
# worth starting. It distinguishes boxes dropped BY DESIGN (traffic lights and
# signs are not path obstacles, so their absence is correct) from boxes belonging
# to classes the taxonomy simply does not recognise -- which is real data being
# silently discarded, and a reason to stop and fix the mapping rather than spend
# twenty-four GPU-hours training on a hole.
echo ""
echo "########## MAPPING REPORT — what survives, and what does not ##########"
python data/prepare_taxonomy.py --src $SRCS --report-only --max-dropped 0.05
REPORT_STATUS=$?
if [ $REPORT_STATUS -ne 0 ]; then
    echo ""
    echo "STOPPING. Too many boxes belong to classes models/taxonomy.py does not"
    echo "recognise. Add them to NAME_TO_GROUP and IDD_LEVEL3_GROUPS (both, they"
    echo "are checked for parity at import), then re-submit."
    exit 1
fi

for LEVEL in fine semantic decision; do
    echo ""
    echo "########## $LEVEL ##########"
    python data/prepare_taxonomy.py \
        --src $SRCS \
        --level "$LEVEL" \
        --out "data/gran_$LEVEL" || exit 1
done

# The experiment is only valid if the three datasets hold identical boxes. If
# they do not, one taxonomy is being scored on easier data than another and any
# conclusion drawn from the comparison is an artefact. Checked here, before six
# GPU-hours are spent on it.
echo ""
echo "########## VALIDITY CHECK — identical box counts ##########"
python - <<'PY' || exit 1
from pathlib import Path
counts = {}
for level in ("fine", "semantic", "decision"):
    total = 0
    for split in ("train", "val"):
        d = Path(f"data/gran_{level}") / split / "labels"
        for f in d.glob("*.txt"):
            total += len(f.read_text().strip().splitlines())
    counts[level] = total
    print(f"  {level:<10} {total:>9} boxes")
if len(set(counts.values())) != 1:
    raise SystemExit(
        "\nFAILED: the three datasets do not contain the same boxes.\n"
        "The granularity comparison would measure a difference in DATA rather\n"
        "than in taxonomy. Check models/taxonomy.py — NAME_TO_GROUP and\n"
        "IDD_LEVEL3_GROUPS must cover exactly the same source class names.")
print("\nOK: all three label spaces cover identical boxes.")
PY

echo ""
echo "============================================"
echo "  DONE  $(date)"
echo "  Next, submit the three trainings (they are independent"
echo "  and may queue in parallel):"
echo "    qsub -v LEVEL=fine     training/pbs/granularity_step2_train.pbs"
echo "    qsub -v LEVEL=semantic training/pbs/granularity_step2_train.pbs"
echo "    qsub -v LEVEL=decision training/pbs/granularity_step2_train.pbs"
echo "============================================"
