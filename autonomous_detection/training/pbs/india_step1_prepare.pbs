#!/bin/bash
# INDIA ADAPTATION — STEP 1: download UVH-26, convert, build both dataset configs
#
# CPU only, no GPU needed.
#
# Submit:  qsub training/pbs/india_step1_prepare.pbs
# Then:    qsub -W depend=afterok:<THIS_JOBID>.mgmt01 training/pbs/india_step2_compare.pbs
#
#PBS -N India_Prepare
#PBS -l select=1:ncpus=8:mem=32gb
#PBS -q workq
#PBS -o /home/krish.123449/logs/india_step1.log
#PBS -j oe
#PBS -V

# NOTE: deliberately NOT using `set -u`. `conda activate` references variables
# (PS1 among others) that are unset in a non-interactive batch shell, and under
# `set -u` the activation aborts silently, leaving /bin/python on PATH instead
# of the environment's interpreter. The project's other working PBS scripts
# omit it for the same reason. `set -e` is also avoided so that a failure in one
# optional stage does not kill the whole job; each stage checks its own status.
set -o pipefail

cd "$PBS_O_WORKDIR" || exit 1

source /home/soft/anaconda3/etc/profile.d/conda.sh
conda activate auto_det
export PATH="$HOME/.local/bin:$PATH"
export PYTHONPATH="$HOME/.local/lib/python3.9/site-packages:$PYTHONPATH"

echo "============================================"
echo "  STEP 1 — UVH-26 download + conversion"
echo "  $(date)"
echo "============================================"
echo "python : $(command -v python)"
echo "version: $(python --version 2>&1)"

# Fail fast and loudly if the environment did not activate — this was the
# original failure mode and it is silent otherwise.
case "$(command -v python)" in
    *auto_det*|*anaconda3*)
        echo "conda environment: OK"
        ;;
    *)
        echo ""
        echo "ERROR: python resolved to $(command -v python), not the auto_det"
        echo "environment. 'conda activate auto_det' did not take effect, so"
        echo "none of the project's packages are importable. Aborting rather"
        echo "than failing confusingly several steps later."
        exit 1
        ;;
esac

# ---------------------------------------------------------------- download ---
# Uses `python -m pip` and the huggingface_hub Python API rather than the
# `pip` / `huggingface-cli` console scripts, which are not reliably on PATH
# inside a batch job.
if [ "${SKIP_DOWNLOAD:-0}" = "1" ]; then
    echo ""
    echo "[1/4] Download skipped (SKIP_DOWNLOAD=1)"
else
    echo ""
    echo "[1/4] Installing huggingface_hub ..."
    python -m pip install -q huggingface_hub
    if [ $? -ne 0 ]; then
        echo "ERROR: could not install huggingface_hub."
        echo "If this is a network error, run the download on the LOGIN node:"
        echo "  python -m pip install huggingface_hub"
        echo "  python -c \"from huggingface_hub import snapshot_download; snapshot_download(repo_id='iisc-aim/UVH-26', repo_type='dataset', local_dir='data/UVH26')\""
        echo "then re-submit with:"
        echo "  qsub -v SKIP_DOWNLOAD=1 training/pbs/india_step1_prepare.pbs"
        exit 1
    fi

    echo ""
    echo "[1/4] Downloading UVH-26 (CC BY 4.0, no registration required) ..."
    python -c "
from huggingface_hub import snapshot_download
p = snapshot_download(repo_id='iisc-aim/UVH-26', repo_type='dataset',
                      local_dir='data/UVH26', max_workers=8)
print('downloaded to:', p)
"
    if [ $? -ne 0 ]; then
        echo ""
        echo "ERROR: download failed. If the traceback above shows a connection"
        echo "or DNS error, this compute node has no outbound internet — run the"
        echo "same snapshot_download on the LOGIN node, then re-submit with:"
        echo "  qsub -v SKIP_DOWNLOAD=1 training/pbs/india_step1_prepare.pbs"
        exit 1
    fi
fi

echo ""
echo "--- what actually landed on disk ---"
du -sh data/UVH26 2>/dev/null
find data/UVH26 -maxdepth 2 -type d 2>/dev/null | head -20
find data/UVH26 -name "*.json" 2>/dev/null | head -10
echo "images found: $(find data/UVH26 \( -name '*.jpg' -o -name '*.png' \) 2>/dev/null | wc -l)"

# ------------------------------------------------------------- conversion ---
echo ""
echo "[2/4] Converting UVH-26 (COCO JSON) -> YOLO, unified taxonomy ..."
python data/prepare_uvh26.py --data_root data/UVH26 --out data/uvh26_yolo
if [ $? -ne 0 ]; then
    echo ""
    echo "ERROR: conversion failed. The most likely cause is that the extracted"
    echo "folder layout differs from what data/prepare_uvh26.py expects:"
    echo "    data/UVH26/UVH-26-Train/{images/, UVH-26-MV-Train.json}"
    echo "    data/UVH26/UVH-26-Val/{images/,   UVH-26-MV-Val.json}"
    echo "Compare that against the 'what actually landed' listing above, then"
    echo "either rename the folders or adjust the paths in the script's main()."
    exit 1
fi

# --------------------------------------------- build both dataset configs ---
echo ""
echo "[3/4] Building the two dataset configs for the controlled comparison ..."

# (a) ADAPTED training set: everything available, including UVH-26
python data/prepare_merged.py --out data/merged_india_yolo --uvh26 data/uvh26_yolo
if [ $? -ne 0 ]; then
    echo "ERROR: merge failed."
    exit 1
fi

# (b) The UVH-26 validation split on its own. This is the COMMON TEST SET that
#     both the baseline and the adapted model are scored on — keeping it
#     separate is what makes the comparison attributable to training data.
mkdir -p data/uvh26_testonly
ln -sfn "$PWD/data/uvh26_yolo/val" data/uvh26_testonly/val
python -c "
from pathlib import Path
names = {0:'car',1:'truck',2:'bus',3:'van',4:'pedestrian',5:'cyclist',
         6:'motorcycle',7:'tram',8:'traffic_light',9:'traffic_sign',10:'misc',
         11:'autorickshaw',12:'animal',13:'rider',14:'vehicle_fallback'}
out = Path('data/uvh26_testonly')
body = '\n'.join('  {}: {}'.format(k, v) for k, v in names.items())
(out / 'uvh26_test.yaml').write_text(
    '# UVH-26 validation split - common test set for the India comparison\n'
    'path: {}\ntrain: val/images\nval: val/images\nnames:\n{}\n'.format(out.resolve(), body))
print('wrote', out / 'uvh26_test.yaml')
"

echo ""
echo "[4/4] Summary"
echo "  UVH-26 train imgs : $(ls data/uvh26_yolo/train/images 2>/dev/null | wc -l)"
echo "  UVH-26 val imgs   : $(ls data/uvh26_yolo/val/images   2>/dev/null | wc -l)"
echo "  merged train imgs : $(ls data/merged_india_yolo/train/images 2>/dev/null | wc -l)"
echo "  merged val imgs   : $(ls data/merged_india_yolo/val/images   2>/dev/null | wc -l)"
echo ""
echo "Next:  qsub training/pbs/india_step2_compare.pbs"
echo "============================================"
echo "  STEP 1 DONE  $(date)"
echo "============================================"
